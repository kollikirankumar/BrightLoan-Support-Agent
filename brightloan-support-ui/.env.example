# Google OAuth 2.0 client ID (from Google Cloud Console -> APIs & Services -> Credentials).
# Optional for now — leave blank and the app uses a local dev sign-in
# (just enter a name, no Google account needed). Fill this in later to
# switch to real Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Backend base URL. Leave empty to use the Vite dev proxy in vite.config.js.
VITE_API_BASE_URL=
