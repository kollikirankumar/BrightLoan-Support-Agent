# From console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key

# Groq model ids change over time (check console.groq.com/docs/models for
# the current list) — openai/gpt-oss-20b is Groq's fast/cheap default as of
# mid-2026, good for a classifier + support-answer workload.
GROQ_MODEL=openai/gpt-oss-20b

CHROMA_PERSIST_DIR=chroma_db

# Optional — handoff email notifications. From console.resend.com -> API Keys.
# Sign up to Resend using HANDOFF_NOTIFICATION_EMAIL itself, since the
# free/no-domain sandbox sender (onboarding@resend.dev) can only send to
# the email address the Resend account was created with.
RESEND_API_KEY=
HANDOFF_FROM_EMAIL=onboarding@resend.dev
HANDOFF_NOTIFICATION_EMAIL=kollikirankumar2001@gmail.com

